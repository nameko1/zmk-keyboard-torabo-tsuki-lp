#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT 0
#define SIGN 1
#define NUMBER 2
#define AUTO_MOUSE 4
#define LOW_DPI 5
#define SCROLL 6
#define VIM_NORMAL 7
#define STAGE 8
#define YANK 9
#define TAPPING_TERM_MS_FAST 180
#define TAPPING_TERM_MS_SLOW 250
#define COMBO_TIMEOUT_MS 150

&lt { flavor = "hold-preferred"; };

/ {
    combos {
        compatible = "zmk,combos";

        escape_combo {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            key-positions = <24 23>;
            bindings = <&kp ESCAPE>;
        };

        kana {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            bindings = <&kp LANG1>;
            key-positions = <24 37>;
        };

        eiji {
            timeout-ms = <COMBO_TIMEOUT_MS>;
            bindings = <&kp LANG2>;
            key-positions = <60 24>;
        };
    };

    macros {
        line_copy: line_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END) &kp LG(C)>;
        };

        yank_word: yank_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_press>,
                <&kp LSHIFT &kp RIGHT>,
                <&macro_release>,
                <&kp LSHIFT>,
                <&macro_release>,
                <&kp LCTRL>,
                <&macro_wait_time 20>,
                <&kp LG(C)>;
        };
    };

    behaviors {
        td_vim: td_v_layer {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS_FAST>;
            bindings = <&tog 7>;
        };

        td_caps: tap_dance_caps_word {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <TAPPING_TERM_MS_SLOW>;
            bindings = <&sk LEFT_SHIFT>, <&caps_word>;
        };

        td_cmd: tap_dance_command {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_GUI>, <&sk LEFT_GUI>;

            tapping-term-ms = <TAPPING_TERM_MS_SLOW>;
            label = "TD_CMD";
        };

        td_opt: tap_dance_option {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_ALT>, <&sk LEFT_ALT>;

            tapping-term-ms = <TAPPING_TERM_MS_SLOW>;
            label = "TD_OPT";
        };

        td_app_switch: tap_dance_app_switch {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&sk LEFT_GUI>, <&sk TAB>;

            tapping-term-ms = <TAPPING_TERM_MS_SLOW>;
            label = "TD_APP_SWITCH";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default {
            bindings = <
&none       &none    &none    &none  &none    &none                            &none        &none  &none      &none    &none          &none
&kp TAB     &kp Q    &kp W    &kp E  &kp R    &kp T                            &kp Y        &kp U  &kp I      &kp O    &kp P          &kp BSPC
&kp LCTRL   &kp A    &kp S    &kp D  &kp F    &kp G        &none      &none    &kp H        &kp J  &kp K      &kp L    &kp SEMICOLON  &kp RET
&kp LSHIFT  &kp Z    &kp X    &kp C  &kp V    &kp B        &kp LG(C)  &kp ESC  &kp N        &kp M  &kp COMMA  &kp DOT  &kp FSLH       &td_caps
&kp F       &td_opt  &td_cmd  &mo 6  &td_cmd  &lt 1 SPACE  &mo 8      &mo 2    &lt 2 SPACE  &none  &none      &kp F    &kp F          &kp F
            >;
        };

        sign {
            bindings = <
&none   &none            &none         &none         &none         &none                            &none      &none          &none         &none     &none     &none
&trans  &kp EXCLAMATION  &kp AT        &kp HASH      &kp DOLLAR    &kp PERCENT                      &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LPAR  &kp RPAR  &trans
&trans  &trans           &trans        &trans        &kp PIPE      &kp TILDE     &none      &none   &kp UNDER  &kp PLUS       &kp LBRC      &kp RBRC  &kp DQT   &trans
&trans  &bt BT_SEL 0     &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &kp LG(V)  &trans  &trans     &trans         &kp LT        &kp GT    &trans    &trans
&trans  &trans           &trans        &trans        &trans        &trans        &trans     &trans  &trans     &none          &none         &trans    &trans    &trans
            >;
        };

        number {
            bindings = <
&none   &none                   &none                   &none                   &none     &none                      &none      &none      &none             &none              &none             &none
&trans  &kp NUMBER_1            &kp NUMBER_2            &kp N3                  &kp N4    &kp N5                     &kp N6     &kp N7     &kp N8            &kp N9             &kp N0            &trans
&trans  &kp N1                  &kp N2                  &kp N3                  &kp BSLH  &kp GRAVE  &none   &none   &kp MINUS  &kp EQUAL  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp SINGLE_QUOTE  &trans
&trans  &kp LS(LA(LC(LG(F1))))  &kp LS(LA(LC(LG(F2))))  &kp LS(LA(LC(LG(F3))))  &kp N9    &kp N0     &trans  &trans  &none      &none      &kp COMMA         &kp DOT            &trans            &trans
&trans  &trans                  &trans                  &trans                  &trans    &trans     &trans  &trans  &trans     &none      &none             &trans             &trans            &trans
            >;
        };

        layer_3 {
            bindings = <
&none   &none    &none    &none         &none         &none                       &none             &none      &none          &none      &none       &none
&trans  &kp F1   &kp F2   &kp F3        &kp F4        &kp F5                      &kp HOME          &kp PG_UP  &kp PAGE_DOWN  &kp END    &kp ESCAPE  &trans
&trans  &kp F6   &kp F7   &kp F8        &kp F9        &kp F10     &trans  &trans  &kp LEFT          &kp DOWN   &kp UP_ARROW   &kp RIGHT  &kp TAB     &trans
&trans  &kp F11  &kp F12  &out OUT_USB  &out OUT_BLE  &bt BT_NXT  &trans  &trans  &kp SINGLE_QUOTE  &kp DQT    &kp GRAVE      &kp TILDE  &kp PIPE    &trans
&trans  &trans   &trans   &trans        &kp DELETE    &kp TAB     &trans  &trans  &trans            &trans     &trans         &trans     &trans      &trans
            >;
        };

        auto_mouse {
            bindings = <
&none  &none  &none      &none            &none        &none                &none  &none  &none  &none  &none  &none
&none  &none  &none      &none            &none        &none                &none  &none  &none  &none  &none  &none
&none  &none  &mkp MCLK  &mkp RCLK        &mkp LCLK    &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none      &kp LC(LS(TAB))  &kp LC(TAB)  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none      &none            &mo 5        &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };

        low_dpi_layer {
            bindings = <
&none  &none  &none  &none  &none  &none                &none  &none            &none        &none      &none  &none
&none  &none  &none  &none  &none  &none                &none  &none            &none        &none      &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &mkp LCLK        &mkp RCLK    &mkp MCLK  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &kp LC(LS(TAB))  &kp LC(TAB)  &none      &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none            &none        &none      &none  &none
            >;
        };

        scroll {
            bindings = <
&none   &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&none   &none   &none   &none   &none   &none                   &none   &none   &none   &none   &none   &none
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans  &trans  &trans
            >;
        };

        vim_normal {
            bindings = <
&none   &none   &none          &none   &none          &none                   &none           &none           &none         &none            &none      &none
&trans  &trans  &trans         &trans  &kp LG(LS(Z))  &trans                  &sl 9           &kp LG(Z)       &to 0         &trans           &kp LG(V)  &trans
&trans  &trans  &trans         &trans  &trans         &trans  &none   &none   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans     &trans
&trans  &trans  &kp BACKSPACE  &trans  &trans         &none   &trans  &trans  &trans          &trans          &trans        &trans           &trans     &trans
&trans  &trans  &trans         &trans  &trans         &trans  &trans  &trans  &trans          &trans          &trans        &trans           &trans     &trans
            >;
        };

        dance_stage {
            bindings = <
&none   &none   &none   &none   &none   &none                   &none     &none     &none        &none      &none      &none
&trans  &trans  &trans  &trans  &trans  &trans                  &sl 9     &trans    &kp LG(TAB)  &trans     &kp LG(V)  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &none   &kp LEFT  &kp DOWN  &kp UP       &kp RIGHT  &trans     &trans
&trans  &trans  &trans  &trans  &to 7   &trans  &trans  &trans  &trans    &trans    &trans       &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans       &trans     &trans     &trans
            >;
        };

        yank {
            bindings = <
&none   &none   &none       &none   &none   &none                   &none       &none   &none   &none   &none   &none
&trans  &trans  &yank_word  &trans  &trans  &trans                  &line_copy  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans  &trans  &trans  &none   &none   &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};

// マウス操作したらtemp layerを延長

&mkp_input_listener { input-processors = <&zip_temp_layer AUTO_MOUSE 1000>; };
